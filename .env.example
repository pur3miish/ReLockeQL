# Copy this file to .env and replace every example URL with a provider you
# explicitly selected. All RPC chains are exposed by the same GraphQL server.
RELOCKEQL_CHAINS={"vaulta":"https://your-vaulta-rpc.example","hyperion_vaulta":"https://your-vaulta-hyperion.example","wax":"https://your-wax-rpc.example"}

# Optional: contracts whose ABIs should extend each configured chain schema.
RELOCKEQL_CONTRACTS={"vaulta":["eosio.token","eosio"],"wax":["eosio.token"]}

# Optional; defaults to 3002.
PORT=3002
