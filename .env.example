# Copy this file to .env. All RPC chains are exposed by the same GraphQL server.
# These ReLocke RPC providers and the EOSphere Hyperion provider are explicit
# examples; applications remain free to replace or extend the map.
RELOCKEQL_CHAINS={"vaulta":"https://eos.relocke.io","hyperion_vaulta":"https://vaulta-hyperion.eosphere.io","telos":"https://telos.relocke.io","xpr":"https://proton.relocke.io","wax":"https://wax.relocke.io","jungle":"https://jungle.relocke.io"}

# Optional: contracts whose ABIs should extend each configured chain schema.
RELOCKEQL_CONTRACTS={"vaulta":["eosio.token","eosio"],"telos":["eosio.token"],"xpr":["eosio.token"],"wax":["eosio.token"],"jungle":["eosio.token"]}

# Optional; defaults to 3002.
PORT=3002
